[Unit]
Description=sing-box outbound carrier for dae
Documentation=https://sing-box.sagernet.org/
After=network-online.target
Wants=network-online.target
# The real config carries subscription credentials, so it is produced at runtime
# by an external generator and deliberately kept out of the image. Skip cleanly
# instead of restart-looping until that file exists.
ConditionPathExists=/etc/sing-box/config.json

[Service]
Type=simple
User=sing-box
Group=sing-box
StateDirectory=sing-box
StateDirectoryMode=0700
ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run
# sing-box reloads its config on SIGHUP without dropping the process.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity

# No capabilities are required: the listener is a loopback port above 1024 and
# outbound sockets need no privilege. Keep it locked down rather than running
# as root, so a poisoned node response cannot reach the rest of the system.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
