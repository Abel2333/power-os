[Unit]
Description=sing-box outbound carrier for dae
Documentation=https://sing-box.sagernet.org/
After=network-online.target
Wants=network-online.target
# The real config carries subscription credentials, so it is produced at runtime
# by an external generator and deliberately kept out of the image. Skip cleanly
# instead of restart-looping until that file exists.
ConditionPathExists=/etc/sing-box/config.json

[Service]
Type=simple
User=sing-box
Group=sing-box
StateDirectory=sing-box
StateDirectoryMode=0700
ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run
# sing-box reloads its config on SIGHUP without dropping the process.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity

# No capabilities are required: the listener is a loopback port above 1024 and
# outbound sockets need no privilege. Keep it locked down rather than running
# as root, so a poisoned node response cannot reach the rest of the system.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
# sing-box opens a netlink socket while initializing its network manager, to
# watch interface and route changes. Without AF_NETLINK it exits immediately
# with "create netlink socket: address family not supported by protocol", and
# because the unit is gated on a config file that only exists at runtime, a
# broken sandbox here stays invisible until the first real start. Verified by
# an A/B run under systemd-run: AF_INET/AF_INET6/AF_UNIX alone reproduces the
# failure, adding AF_NETLINK fixes it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
